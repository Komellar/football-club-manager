# Database Configuration (TypeORM) - Docker PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=football_club_manager

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=development
PORT=4000
# Set when running behind a reverse proxy (number of hops, e.g. 1) so rate
# limits see the client IP instead of the proxy IP
# TRUST_PROXY=1
